# Choose a local password and use its URL-encoded value in the database URL.
# These variables initialize a NEW database; changing them does not rotate an existing password.
POSTGRES_PASSWORD=replace-with-your-local-password
BUILDLENS_DATABASE_URL=postgresql+psycopg://buildlens:replace-with-your-local-password@127.0.0.1:5432/buildlens
BUILDLENS_ENVIRONMENT=development
BUILDLENS_API_HOST=127.0.0.1
BUILDLENS_API_PORT=8000
# Repository onboarding limits. Scans are synchronous and metadata-only.
BUILDLENS_SCAN_MAX_ENTRIES=100000
BUILDLENS_SCAN_MAX_DEPTH=64
BUILDLENS_SCAN_TIMEOUT_SECONDS=60
BUILDLENS_SCAN_GIT_TIMEOUT_SECONDS=10
# Stage 6 remains offline at runtime; acquire this exact model with the CLI first.
BUILDLENS_EMBEDDINGS_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
BUILDLENS_EMBEDDINGS_CACHE_DIR=~/.cache/buildlens/embeddings
BUILDLENS_EMBEDDINGS_MAX_CHUNKS=20000
BUILDLENS_EMBEDDINGS_MAX_SOURCE_BYTES=67108864
BUILDLENS_EMBEDDINGS_MAX_WINDOWS_PER_CHUNK=32
BUILDLENS_EMBEDDINGS_MAX_WINDOWS=100000
BUILDLENS_EMBEDDINGS_MAX_COLLECTION_BYTES=67108864
BUILDLENS_EMBEDDINGS_WORKER_MAX_RSS_BYTES=2147483648
BUILDLENS_EMBEDDINGS_PREPARATION_TIMEOUT_SECONDS=300
BUILDLENS_EMBEDDINGS_SEARCH_TIMEOUT_SECONDS=15
# Stage 9 reranking is also explicitly acquired and download-free at runtime.
BUILDLENS_RERANKER_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
BUILDLENS_RERANKER_CACHE_DIR=~/.cache/buildlens/reranking
BUILDLENS_RERANKER_BATCH_SIZE=8
BUILDLENS_RERANKER_WORKER_MAX_RSS_BYTES=2147483648
BUILDLENS_RERANKER_MODEL_LOAD_TIMEOUT_SECONDS=60
BUILDLENS_RERANKER_INFERENCE_TIMEOUT_SECONDS=45
BUILDLENS_CONTEXT_REQUEST_TIMEOUT_SECONDS=120
BUILDLENS_CONTEXT_MAX_SOURCE_BYTES=2097152
BUILDLENS_CONTEXT_MAX_RESPONSE_BYTES=4194304
BUILDLENS_CONTEXT_MAX_BYTES=32000
BUILDLENS_CONTEXT_MAX_ITEMS=16
# Ask sends a question and bounded screened evidence to the selected provider when enabled.
BUILDLENS_ASK_ENABLED=false
BUILDLENS_GENERATION_PROVIDER=gemini
# BUILDLENS_GEMINI_API_KEY=your-server-side-key
# BUILDLENS_OPENAI_API_KEY=your-server-side-key
