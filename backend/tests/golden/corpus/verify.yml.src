name: BuildLens verification
on: [push, pull_request]
jobs:
  backend:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python: ['3.11', '3.14']
    services:
      postgres:
        image: pgvector/pgvector:0.8.6-pg16-bookworm@sha256:ccc6e83d6e35e931dc7c5def2022729d5a6c370318d099181995567ff1fb4d6b
        env:
          POSTGRES_HOST_AUTH_METHOD: trust
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      BUILDLENS_TEST_ADMIN_URL: postgresql+psycopg://postgres@127.0.0.1:5432/postgres
      PYTHONPATH: src
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
      - run: python -m pip install uv==0.12.3
      - run: uv sync --frozen --extra dev --extra generation --no-editable
      # Base install: no framework packages. Lab unit/boundary tests still run here.
      - run: uv run --no-sync pytest -m "not real_model and not real_provider and not lab"
      - run: uv run --no-sync ruff check .
      - run: uv run --no-sync ruff format --check .
      - run: uv run --no-sync mypy
  lab:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python: ['3.11', '3.14']
    services:
      postgres:
        image: pgvector/pgvector:0.8.6-pg16-bookworm@sha256:ccc6e83d6e35e931dc7c5def2022729d5a6c370318d099181995567ff1fb4d6b
        env:
          POSTGRES_HOST_AUTH_METHOD: trust
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      BUILDLENS_TEST_ADMIN_URL: postgresql+psycopg://postgres@127.0.0.1:5432/postgres
      PYTHONPATH: src
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
      - run: python -m pip install uv==0.12.3
      - run: uv sync --frozen --extra dev --extra generation --extra lab-langchain --extra lab-llamaindex --extra lab-pgvector --extra lab-code --no-editable
      # Offline: workers deny egress; no models are downloaded (deterministic providers).
      - run: uv run --no-sync pytest -m "lab and not real_model and not real_provider"
      - run: uv run --no-sync pytest tests/unit/test_lab_runtime.py tests/unit/test_lab_domain.py
  provisioning-failure:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-bookworm@sha256:bb3e1a57e5407e0a5280b4211980a5e537f4abd234a87014ac979849a78dd825
        env:
          POSTGRES_HOST_AUTH_METHOD: trust
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      BUILDLENS_DATABASE_URL: postgresql+psycopg://postgres@127.0.0.1:5432/postgres
      PYTHONPATH: src
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: python -m pip install uv==0.12.3
      - run: uv sync --frozen --extra dev --no-editable
      - name: Reject PostgreSQL without pgvector binaries
        shell: bash
        run: |
          set +e
          output=$(uv run --no-sync alembic upgrade head 2>&1)
          status=$?
          set -e
          test "$status" -ne 0
          grep -F "BuildLens requires pgvector 0.8.6 binaries on PostgreSQL 16" <<<"$output"
  frontend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
          cache-dependency-path: frontend/package-lock.json
      - run: npm ci
      - run: npm test
      - run: npm run lint
      - run: npm run build
  real-model:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: pgvector/pgvector:0.8.6-pg16-bookworm@sha256:ccc6e83d6e35e931dc7c5def2022729d5a6c370318d099181995567ff1fb4d6b
        env:
          POSTGRES_HOST_AUTH_METHOD: trust
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      BUILDLENS_DATABASE_URL: postgresql+psycopg://postgres@127.0.0.1:5432/postgres
      BUILDLENS_TEST_ADMIN_URL: postgresql+psycopg://postgres@127.0.0.1:5432/postgres
      BUILDLENS_EMBEDDINGS_CACHE_DIR: ${{ runner.temp }}/buildlens-embeddings
      BUILDLENS_RERANKER_CACHE_DIR: ${{ runner.temp }}/buildlens-reranking
      PYTHONPATH: src
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: python -m pip install uv==0.12.3
      - run: uv sync --frozen --extra dev --extra embeddings --extra reranking --no-editable
      - run: uv run --no-sync buildlens embeddings download-model
      - run: uv run --no-sync buildlens reranking download-model
      - run: uv run --no-sync pytest -m real_model
